#include <stdio.h>

    //Minimum Salary
    const float Minimum_Salary = 1621.0f;

        //information of the people
    typedef struct PeopleInformation
    {
        float Gross_salary;
        float Liquid_salary;
    }PeopleInformation;
    
    /* INSS:The INSS is Brazil's public social security system that collects monthly contributions from workers 
    to guarantee them income replacement, such as pensions, disability benefits, and maternity pay.*/
    typedef struct INSS
    {
       float Percentage_rate;
       float Fee_amount;
    } INSS;

    /*IRRF (Imposto de Renda Retido na Fonte) is a monthly Brazilian tax automatically deducted from an employee's
     paycheck by the employer and paid directly to the government as an advance on their annual income tax.*/
    typedef struct IRRF
    {
        float Percentage_rate;
        float Fee_amount;
    }IRRF;
     
    //Calculate INSS
    INSS Calculate_INSS( float Gross_salary ){
        INSS inss;
        inss.Fee_amount = 0;
        inss.Percentage_rate = 0;
        if (Gross_salary <= Minimum_Salary)
        {
            inss.Percentage_rate = 8;
            inss.Fee_amount = Gross_salary * 0.08;
        }
        else if (Gross_salary <= Minimum_Salary * 5)
        {
            inss.Percentage_rate = 9;
            inss.Fee_amount = Gross_salary * 0.09;
        }
        else if (Gross_salary <= Minimum_Salary * 10)
        {
            inss.Percentage_rate = 11;
            inss.Fee_amount = Gross_salary * 0.11;
        }
        else {
            inss.Fee_amount = Minimum_Salary * 1.1;
            inss.Percentage_rate = (inss.Fee_amount / Gross_salary) * 100.0f;

        }
            return inss;
    }





